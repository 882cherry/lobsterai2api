# 环境变量模板 —— 复制为 .env 放在同目录即可生效（.env 已被 gitignore，不会提交）。
#
# server / login / credit 三个程序启动时都会自动读取 .env，
# 所以不必写进 ~/.bashrc，也不必每次在终端 export。
#
# 优先级：真实环境变量 > .env（同一个文件里后写的覆盖先写的）
# 查找顺序：$LB2A_ENV_FILE > 当前工作目录/.env > 可执行文件同目录/.env
# 语法：KEY=VALUE；# 开头是注释；可带 export 前缀；值两端成对的引号会被去掉

# 上游 API 基址（必填，server / login / credit 都用）
LB2A_UPSTREAM_BASE=https://your-upstream-host

# 登录页地址（login 工具用它生成登录链接）
LB2A_LOGIN_PORTAL=https://your-portal-host

# 以下按需开启
# LB2A_LISTEN=:8367
# LB2A_API_KEY=
# LB2A_AUTH_DIR=./auths
# LB2A_STATE_FILE=./data/state.json
